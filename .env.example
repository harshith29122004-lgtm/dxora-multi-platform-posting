# LinkedIn: use an access token with the appropriate posting permission and a member URN.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
# Use a currently supported YYYYMM version for your LinkedIn developer app.
LINKEDIN_API_VERSION=202609

# Mastodon: instance URL and an access token with write:statuses permission.
MASTODON_BASE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# Bluesky: use an app password, not your account password.
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# WordPress: site URL, username and an Application Password.
WORDPRESS_BASE_URL=https://your-site.example
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=

# Telegram: bot token and destination chat/channel ID. Bot must be allowed to post there.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
